---
import { LOGO_SOURCES } from '../../lib/const';

interface Props {
  class?: string;
  variant?: 'default' | 'white';
}

const { class: className, variant = 'default' } = Astro.props;

const { src, width, height } = LOGO_SOURCES[variant];
---

<a href='/' class:list={[className]}>
  <img
    src={src}
    width={width}
    height={height}
    alt='Productized Services Italia'
    class='h-6 w-auto md:h-auto'
  />
</a>
