---
import ArrowIcon from './icons/ArrowIcon.astro';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex h-10 shrink-0 items-center gap-2 whitespace-nowrap rounded-xl bg-white/10 pr-3 pl-5 text-sm leading-none font-bold text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white',
    className,
  ]}
>
  <slot />
  <ArrowIcon aria-hidden="true" class="size-4" />
</a>
