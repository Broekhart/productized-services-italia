---
import ArrowIcon from './icons/ArrowIcon.astro';

interface Props {
  href: string;
  variant?: 'translucent' | 'solid' | 'outline';
  class?: string;
}

const { href, variant = 'translucent', class: className } = Astro.props;

const variants = {
  translucent: 'bg-white/10 text-white focus-visible:outline-white',
  solid: 'bg-black text-white focus-visible:outline-black',
  outline: 'bg-white text-black border border-black/10 focus-visible:outline-black',
};
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-10 shrink-0 items-center gap-2 rounded-xl py-2 pr-3 pl-5 text-sm leading-none font-bold focus-visible:outline-2 focus-visible:outline-offset-2',
    variants[variant],
    className,
  ]}
>
  <slot />
  <ArrowIcon aria-hidden="true" class="size-4" />
</a>
