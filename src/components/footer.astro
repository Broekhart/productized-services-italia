---
import Logo from './ui/logo.astro';
import Linkedin from './ui/icons/linkedin.astro';
import Instagram from './ui/icons/instagram.astro';
import Telegram from './ui/icons/telegram.astro';
import { NAV_LINKS } from '../lib/const';
---

<footer class='bg-black text-white'>
  <div class='px-container pt-10 pb-17 md:pt-16'>
    <div class='flex flex-wrap items-center justify-between gap-4'>
      <Logo variant='light' />

      <nav aria-label='Link del footer' class='flex flex-wrap items-center gap-6'>
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class='text-base leading-normal font-medium text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white'>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <hr class='mt-8 border-t border-white/5' />

    <div class='mt-5 flex flex-wrap items-center justify-between gap-4'>
      <p class='text-sm leading-normal text-white/40'>© Productized Services Italia</p>

      <div class='flex items-center gap-4'>
                <a
          href='#'
          aria-label='Telegram'
          class='text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'>
          <Telegram outline class='size-5' />
        </a>
        <a
          href='#'
          aria-label='LinkedIn'
          class='text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'>
          <Linkedin class='size-6' />
        </a>
        <a
          href='#'
          aria-label='Instagram'
          class='text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'>
          <Instagram class='size-5' />
        </a>
      </div>
    </div>
  </div>
</footer>
