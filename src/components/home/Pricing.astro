---
import Button from '../ui/Button.astro';
import CheckCircleOutlineIcon from '../ui/icons/CheckCircleOutlineIcon.astro';
import BurstBadgeIcon from '../ui/icons/BurstBadgeIcon.astro';

const monthlyFeatures = [
  'Accesso completo alla community',
  'Corso completo incluso',
  'Tutti i 5 moduli',
  'Accesso al network e alle opportunità',
  'Telegram gratuito',
];

const annualFeatures = [
  'Risparmia 2 mesi con il piano annuale.',
  'Accesso completo alla community',
  'Corso completo incluso',
  'Tutti i 5 moduli',
  'Accesso al network e alle opportunità',
  'Telegram gratuito',
];
---

<section class="relative overflow-hidden bg-white">
  <div
    class="relative bg-[#FA5A6E]"
    style={{
      backgroundImage:
        'repeating-conic-gradient(from 200deg at 75% -30%, #FA5A6E 0deg 8deg, #FC7183 8deg 16deg)',
    }}
  >
    <div class="relative px-container pt-20 pb-[230px]">
      <span class="inline-flex rounded-full bg-[#FFFFFF4D] px-[14px] py-[6px] text-sm leading-none font-bold text-white uppercase">
        Scegli il tuo piano
      </span>

      <h2 class="mt-[17px] max-w-3xl font-bold text-white leading-[1.25] tracking-[-1px]">
        Tutto ciò che ti serve per costruire il tuo Productized Service.
      </h2>
    </div>
  </div>

  <div class="relative px-container pb-20">
    <div class="-mt-[180px] flex flex-col items-center gap-8 lg:flex-row lg:items-start lg:justify-center">
      <div class="w-full rounded-2xl border border-black/5 bg-white p-8 shadow-sm lg:w-[602px]">
        <span class="text-base leading-[1.15] font-bold tracking-[0.06em] text-[#FA5A6E] uppercase">
          Piano Mensile
        </span>

        <div class="mt-7 flex items-baseline gap-2">
          <span class="text-[64px] leading-[1.15] font-bold text-black">€49</span>
          <span class="text-base leading-[1.15] font-semibold tracking-[-0.05em] text-black/60">/mese</span>
        </div>

        <p class="mt-7 text-base leading-[1.5] tracking-[-0.05em] text-black/60">
          Tutto ciò che ti serve per trasformare il tuo servizio in un'offerta productized. Accesso alla
          community, corso completo e tutte le opportunità riservate ai membri.
        </p>

        <hr class="mt-7 border-t border-[#8593A329]" />

        <ul class="mt-7 flex flex-col gap-4">
          {
            monthlyFeatures.map((feature) => (
              <li class="flex items-center gap-4">
                <CheckCircleOutlineIcon class="size-6 shrink-0" />
                <span class="text-base leading-[1.5] font-medium tracking-[-0.05em] text-black">{feature}</span>
              </li>
            ))
          }
        </ul>

        <Button href="#" variant="outline" class="mt-8 w-full justify-center">
          Entra nella community Skool
        </Button>
      </div>

      <div class="relative w-full rounded-2xl border border-black/5 bg-white p-8 shadow-sm lg:w-[602px]">
        <div class="absolute -top-8 -right-4 flex h-[123px] w-[140px] rotate-[14deg] flex-col items-center justify-center text-center">
          <BurstBadgeIcon class="absolute inset-0 -z-10 h-full w-full" />
          <span class="text-[16.86px] leading-[1.15] font-bold text-black">Risparmia</span>
          <span class="text-[21.08px] leading-[1.15] font-bold text-black">€98</span>
        </div>

        <span class="text-base leading-[1.15] font-bold tracking-[0.06em] text-[#FA5A6E] uppercase">
          Piano Annuale
        </span>

        <div class="mt-7 flex flex-wrap items-baseline gap-3">
          <span class="text-[36px] leading-[1.15] font-bold text-black/40 line-through">€588</span>
          <div class="flex flex-wrap items-baseline gap-2">
            <span class="text-[64px] leading-[1.15] font-bold text-black">€490</span>
            <span class="text-base leading-[1.15] font-semibold tracking-[-0.05em] text-black/60">/anno</span>
          </div>
        </div>

        <p class="mt-7 text-base leading-[1.5] tracking-[-0.05em] text-black/60">
          Un anno intero per costruire e far crescere il tuo Productized Service. Accesso completo alla
          community, al corso e alle opportunità di lavoro, con un unico pagamento annuale.
        </p>

        <hr class="mt-7 border-t border-[#8593A329]" />

        <ul class="mt-7 flex flex-col gap-4">
          {
            annualFeatures.map((feature) => (
              <li class="flex items-center gap-4">
                <CheckCircleOutlineIcon class="size-6 shrink-0" />
                <span class="text-base leading-[1.5] font-medium tracking-[-0.05em] text-black">{feature}</span>
              </li>
            ))
          }
        </ul>

        <Button href="#" variant="solid" class="mt-8 w-full justify-center">
          Entra nella community Skool
        </Button>
      </div>
    </div>
  </div>
</section>
