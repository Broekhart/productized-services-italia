---
import Button from '../ui/Button.astro';
---

<section class="relative flex min-h-dvh flex-col justify-center overflow-hidden bg-black text-white">
  <div
    class="hero-glow pointer-events-none absolute inset-0 bg-[url('/images/hero-gradient-bg.png')] bg-cover bg-right-bottom bg-no-repeat"
    aria-hidden="true"
  >
  </div>

  <div class="relative px-container flex flex-col py-container">
    <div class="inline-flex items-center gap-2 self-start rounded-full bg-white/15 py-2 pr-[18px] pl-2">
      <span class="rounded-full bg-[#B44EEB] px-2.5 py-1 text-sm leading-none font-semibold text-white uppercase">
        Per freelance
      </span>
      <span class="text-sm leading-none font-semibold text-white">
        e fondatori di agenzia che vogliono lavorare ad abbonamento
      </span>
    </div>

    <h1 class="mt-[22px] max-w-4xl leading-[1.1] tracking-[-0.03em] break-words">
      Non devi prodottizzare il tuo business da solo.
    </h1>

    <p class="mt-[18px] w-[637px] max-w-full text-lg leading-normal text-white/60">
      Unisciti alla community italiana più grande sui servizi prodottizzati: confrontati con chi lo sta già
      facendo, trova clienti e collaboratori, e segui il percorso passo passo per lanciare e scalare il tuo
      abbonamento.
    </p>

    <Button href="#" class="mt-10 self-start">Entra nella community</Button>

    <p class="mt-[31px] self-start text-sm leading-none font-medium">
      <span class="text-[#D1DF64]">Vuoi fare una prova?</span>
      <a href="#" class="font-bold text-white underline">Entra gratis nel gruppo Telegram</a>
    </p>
  </div>
</section>

<style>
  @property --glow-reach {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  /* On load the gradient grows out of the bottom-right corner in 6 distinct steps, each brighter and more complete. */
  .hero-glow {
    --glow-reach: 0%;
    mask-image: radial-gradient(circle at 100% 100%, #000 calc(var(--glow-reach) * 0.55), transparent var(--glow-reach));
    animation: hero-glow-in 6s steps(6, jump-end) both;
  }

  @keyframes hero-glow-in {
    from {
      --glow-reach: 0%;
      filter: brightness(0.15);
    }
    to {
      --glow-reach: 160%;
      filter: brightness(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow {
      animation: none;
      mask-image: none;
    }
  }
</style>
