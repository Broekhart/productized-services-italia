---
import StarIcon from '../ui/icons/StarIcon.astro';

const testimonials = [
  {
    avatar: '/images/sean.webp',
    name: 'Sean Rose',
    role: 'Direttore Commerciale, Azienda Tecnologica',
    quote:
      'Lorem ipsum dolor sit amet consectetur. Felis hendrerit tempor felis vestibulum facilisi. Id in sapien ut integer. Cras a etiam in sem luctus nisl vitae vel vitae.',
    rating: 4,
  },
  {
    avatar: '/images/dimetria.webp',
    name: 'Demetria Giles',
    role: 'Fondatore, Agenzia di Marketing',
    quote:
      'Lorem ipsum dolor sit amet consectetur. Felis hendrerit tempor felis vestibulum facilisi. Id in sapien ut integer. Cras a etiam in sem luctus nisl vitae vel vitae.',
    rating: 5,
  },
  {
    avatar: '/images/ryan.webp',
    name: 'Ryan Delk',
    role: 'Partner, Società di Servizi Professionali',
    quote:
      'Lorem ipsum dolor sit amet consectetur. Felis hendrerit tempor felis vestibulum facilisi. Id in sapien ut integer. Cras a etiam in sem luctus nisl vitae vel vitae.',
    rating: 4,
  },
];
---

<section class="relative overflow-hidden bg-black">
  <div class="absolute inset-0 bg-[url('/images/gradient-bg-trimmed.webp')] bg-cover bg-bottom"></div>
  <div class="absolute inset-0 bg-[#000000BD]"></div>

  <div class="relative py-20">
    <div class="px-container text-center">
      <span class="inline-flex rounded-full bg-white/10 px-3.5 py-1.5 text-sm leading-none font-bold text-[#D1DF64] uppercase">
        Cosa dicono i membri
      </span>

      <h2 class="mt-[17px] font-bold text-white leading-[1.25] tracking-[-1px]">Non Lo Diciamo Solo Noi.</h2>
    </div>

    <div class="mt-14 flex flex-col gap-6">
      <div class="overflow-hidden">
        <div class="testimonials-row-1 flex w-max gap-6 px-container">
          {
            [...testimonials, ...testimonials].map((t, i) => (
              <div
                aria-hidden={i >= testimonials.length}
                class="w-[420px] shrink-0 rounded-[24px] bg-white/5 py-9 px-[30px]"
              >
                <div class="flex items-center gap-3">
                  <img src={t.avatar} alt="" class="size-11 shrink-0 rounded-full object-cover" />
                  <div>
                    <p class="text-base leading-[1.5] font-normal text-[#F4F0FF]">{t.name}</p>
                    <p class="text-xs leading-[1.5] font-normal text-[#EFEDFD99]">{t.role}</p>
                  </div>
                </div>

                <p class="mt-4 text-base leading-[1.5] font-normal text-[#FEFEFE]">&ldquo;{t.quote}&rdquo;</p>

                <div class="mt-4 flex gap-1">
                  {Array.from({ length: 5 }).map((_, star) => (
                    <StarIcon class={`size-4 ${star < t.rating ? 'text-[#F5A623]' : 'text-white/20'}`} />
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="overflow-hidden">
        <div class="testimonials-row-2 flex w-max gap-6 px-container">
          {
            [...testimonials, ...testimonials].map((t, i) => (
              <div
                aria-hidden={i >= testimonials.length}
                class="w-[420px] shrink-0 rounded-[24px] bg-white/5 py-9 px-[30px]"
              >
                <div class="flex items-center gap-3">
                  <img src={t.avatar} alt="" class="size-11 shrink-0 rounded-full object-cover" />
                  <div>
                    <p class="text-base leading-[1.5] font-normal text-[#F4F0FF]">{t.name}</p>
                    <p class="text-xs leading-[1.5] font-normal text-[#EFEDFD99]">{t.role}</p>
                  </div>
                </div>

                <p class="mt-4 text-base leading-[1.5] font-normal text-[#FEFEFE]">&ldquo;{t.quote}&rdquo;</p>

                <div class="mt-4 flex gap-1">
                  {Array.from({ length: 5 }).map((_, star) => (
                    <StarIcon class={`size-4 ${star < t.rating ? 'text-[#F5A623]' : 'text-white/20'}`} />
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials-row-1 {
    animation: testimonials-scroll 40s linear infinite;
  }

  .testimonials-row-2 {
    animation: testimonials-scroll 40s linear infinite reverse;
  }

  @keyframes testimonials-scroll {
    to {
      transform: translateX(calc(-50% - 12px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials-row-1,
    .testimonials-row-2 {
      animation: none;
    }
  }
</style>
