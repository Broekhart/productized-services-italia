---
import { METHOD_COLUMNS } from "../../lib/const";
import Badge from "../ui/badge.astro";
import Button from "../ui/button.astro";
import Arrow from "../ui/icons/arrow.astro";
import YellowMascotte from "../ui/illustrations/yellow-mascotte.astro";
---

<section class="bg-yellow-bg">
	<div class="p-container flex flex-col gap-15.5">
		<div class="flex justify-between gap-10.5">
			<div class="flex flex-col items-start gap-4">
				<Badge variant="light-yellow"> Il metodo </Badge>

				<h2>
					Il metodo pratico per costruire, vendere e gestire servizi
					prodottizzati.
				</h2>
			</div>

			<YellowMascotte class="hidden size-33 shrink-0 md:block" />
		</div>

		<div class="grid gap-12 lg:grid-cols-[320px_1fr] items-start">
			<div
				class="relative rounded-3xl bg-[url('/images/method-bg.webp')] bg-cover bg-bottom p-8"
			>
				<div class="absolute inset-0 bg-yellow/59 rounded-3xl"></div>
				<div class="flex flex-col gap-6 relative">
					<svg
						width="47"
						height="50"
						viewBox="0 0 47 50"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
						xmlns:xlink="http://www.w3.org/1999/xlink"
						class="ml-auto"
					>
						<title>Mascotte decorativa</title>
						<rect
							x="4.72046"
							width="41.7943"
							height="45.5094"
							transform="rotate(5.95361 4.72046 0)"
							fill="url(#pattern0_355_1610)"
						/>
						<defs>
							<pattern
								id="pattern0_355_1610"
								patternContentUnits="objectBoundingBox"
								width="1"
								height="1"
							>
								<use
									xlink:href="#image0_355_1610"
									transform="matrix(0.00776933 0 0 0.00713504 -1.27779 -0.223618)"
								/>
							</pattern>
							<image
								id="image0_355_1610"
								width="717"
								height="348"
								preserveAspectRatio="none"
								xlink:href="data:image/png;base64,"
							/>
						</defs>
					</svg>

					<p class="text-base leading-normal font-medium text-[#161219]">
						Questo percorso fatto in solitaria può essere molto insidioso, e lo
						dico perché ci sono passato. Proprio per questo ho creato una
						roadmap che ti permetterà di non commettere gli errori che ho
						commesso io e di accelerare il tuo percorso.
					</p>
				</div>
			</div>

			<div class="flex flex-col items-start gap-8">
				<div class="grid w-full gap-6 md:grid-cols-2">
					{METHOD_COLUMNS.map((column) => (
						<div class="flex flex-col gap-6">
							{column.map((text, i) => {
								const number = String(
									column === METHOD_COLUMNS[0] ? i + 1 : i + 6,
								).padStart(2, "0");

								return (
									<div class="flex gap-4 border-b border-black/10 pb-6">
										<span class="font-bold text-violet">{number}</span>
										<span class="font-medium text-black">{text}</span>
									</div>
								);
							})}
						</div>
					))}
				</div>

				<p class="font-medium text-black/60">
					Incluso per tutti i membri della community Pro (il corso è incluso
					nell’abbonamento Skool, non è venduto separatamente).
				</p>

				<Button
					href="https://www.skool.com/productized-services-italia-4079/about"
					target="_blank"
					rel="noopener noreferrer"
					variant="secondary"
					class="mt-2"
					>Accedi al corso entrando nella community <Arrow /></Button
				>
			</div>
		</div>
	</div>
</section>
