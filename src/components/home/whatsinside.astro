---
import { WHATS_INSIDE_CARDS } from '../../lib/const';
import Badge from '../ui/badge.astro';
import Button from '../ui/button.astro';
import ArrowIcon from '../ui/icons/arrow.astro';
import HalfLogo from '../ui/illustrations/half-logo.astro';
---

<section class='overflow-hidden bg-[#FBF7FF]'>
  <div class='flex flex-col items-center gap-12 relative px-container py-20'>
    <div class='flex flex-col gap-4 items-center text-center'>
      <Badge variant='violet'> Cosa trovi dentro </Badge>

      <h2 class='max-w-4xl'>Tutto ciò di cui hai bisogno, in un unico posto.</h2>
    </div>

    <div class='relative max-w-6xl'>
      <HalfLogo class='absolute -top-24 -left-24' />
      <HalfLogo variant='right' class='absolute -bottom-24 -right-24' />

      <div class='grid lg:grid-cols-3 gap-8'>
        {
          WHATS_INSIDE_CARDS.map(({ color, illustration: Illustration, title, body }) => (
            <div
              style={`--card-color: var(--color-${color})`}
              class:list={[
                'flex flex-col gap-7.5 rounded-[28px] border border-black/5 bg-white p-4.5 hover:border-(--card-color)',
              ]}>
              <Illustration class='w-full' />
              <div class='flex flex-col gap-2'>
                <h3 class='text-xl leading-none font-bold text-(--card-color)'>{title}</h3>
                <p class='text-sm leading-normal text-black/60'>{body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <Button
      href='https://www.skool.com/productized-services-italia-4079/about'
      target='_blank'
      rel='noopener noreferrer'
      variant='secondary'>
      Entra nella community <ArrowIcon />
    </Button>
  </div>
</section>
