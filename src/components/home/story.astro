---
import Badge from '../ui/badge.astro';
---

<section class='relative py-container'>
  <div class="absolute top-0 left-0 w-full h-110 bg-[url('/images/bg-spiral.webp')] bg-cover bg-center"></div>
  <div class='flex flex-col gap-10.5 relative px-container'>
    <div class='flex flex-col gap-4 items-start text-white'>
      <Badge variant='light-coral'> La storia dietro la community </Badge>
      <h2 class='max-w-4xl'>Perché esiste Productized Services Italia E come può aiutarti?</h2>
    </div>
    <video-player>
      <!--
    Skins contain the entire player UI and are easily swappable.
    Add the skin source to your project for full control over its
    UI components.
   -->
      <video-compat-skin
        style='--media-accent-color: #f5c518; display: block; width: 100%; aspect-ratio: 16 / 9;'>
        <!--
        Media are players without UIs, handling networking
        and display of the media. They are easily swappable
        to handle different sources.
      -->
        <video
          src='https://stream.mux.com/BV3YZtogl89mg9VcNBhhnHm02Y34zI1nlMuMQfAbl3dM/highest.mp4'
          playsinline><a href='https://videojs.org/help'>Video player not working?</a></video
        >
      </video-compat-skin>
    </video-player>
  </div>
</section>
