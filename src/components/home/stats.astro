---
import { STATS_CARDS } from '../../lib/const';
---

<section class='p-container grid lg:grid-cols-3 gap-4'>
  {
    STATS_CARDS.map((card) => (
      <div
        class={`flex flex-col items-center justify-center rounded-3xl px-4 py-7.5 text-center ${card.cardClass}`}>
        <p class='text-[40px] leading-none font-bold'>
          <span class='stat-window' aria-hidden='true'>
            <span class='stat-reel'>
              <span>{card.value}</span>
            </span>
          </span>
        </p>
        <p class='mt-4 text-base leading-none font-medium tracking-normal'>{card.label}</p>
      </div>
    ))
  }
</section>
