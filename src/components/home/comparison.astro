---
import { ROWS } from '../../lib/const';
import Button from '../ui/button.astro';
import Telegram from '../ui/icons/telegram.astro';
import CheckCircle from '../ui/icons/checkcircle.astro';
import CrossCircle from '../ui/icons/crosscircle.astro';
import Arrow from '../ui/icons/arrow.astro';
import Badge from '../ui/badge.astro';
import Skool from '../ui/icons/skool.astro';
---

<section class='bg-white'>
  <div class='flex flex-col gap-10 p-container'>
    <div class='flex flex-col gap-4 items-center text-center'>
      <Badge variant='dark-coral'> Confronto </Badge>

      <h2 class='max-w-2xl'>Gratis per iniziare. A pagamento per evolvere.</h2>
    </div>

    <div class='relative'>
      <div class='overflow-x-auto'>
        <div class='min-w-3xl rounded-[28px] overflow-hidden border border-black/10'>
          <div class='grid grid-cols-3'>
            <div class='bg-white'></div>
            <div class='flex items-center gap-2.5 bg-[#69DBFC2E] px-6 py-5'>
              <Telegram class='size-7 shrink-0' />
              <span class='text-lg font-bold text-black'>Gruppo Telegram</span>
            </div>
            <div class='flex items-center gap-2.5 bg-[#B44EEB] px-6 py-5'>
              <Skool class='size-7 shrink-0' />

              <span class='text-lg font-bold text-white'>Community Skool</span>
            </div>
          </div>

          {
            ROWS.map((row) => (
              <div class='grid grid-cols-3 border-t border-black/5'>
                <div class='flex items-center bg-white px-6 py-5'>
                  <span class='text-sm font-semibold text-black'>{row.label}</span>
                </div>
                <div class='flex items-center bg-[#69DBFC12] px-6 py-5'>
                  {row.telegram === 'check' ? (
                    <CheckCircle />
                  ) : row.telegram === 'cross' ? (
                    <CrossCircle />
                  ) : (
                    <span>{row.telegram}</span>
                  )}
                </div>
                <div class='flex items-center bg-[#B44EEB0F] px-6 py-5'>
                  {row.skool === 'check' ? (
                    <CheckCircle />
                  ) : row.skool === 'cross' ? (
                    <CrossCircle />
                  ) : (
                    <span>{row.skool}</span>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class='flex flex-col gap-4 items-center text-center'>
      <Button
        href='https://www.skool.com/productized-services-italia-4079/about'
        target='_blank'
        rel='noopener noreferrer'
        variant='secondary'>Entra nella community Skool <Arrow /></Button
      >

      <a
        href='https://t.me/+hQY7xF5CxSE1MDI0'
        target='_blank'
        rel='noopener noreferrer'
        class='text-sm font-bold text-violet underline'>
        Prova prima il gruppo Telegram gratis
      </a>
    </div>
  </div>
</section>
