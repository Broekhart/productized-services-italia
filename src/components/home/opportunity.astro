---
import { OPPORTUNITY_PILLS, OPPORTUNITY_TESTIMONIALS } from '../../lib/const';
import Button from '../ui/button.astro';
---

<section class="relative overflow-hidden bg-black">
  <div class="absolute inset-0 bg-[url('/images/gradient-bg-trimmed.webp')] bg-cover bg-bottom"></div>
  <div class="absolute inset-0 bg-[#000000A1]"></div>

  <div class="relative py-20">
    <div class="px-container text-center">
      <span class="inline-flex rounded-full bg-white/10 px-3.5 py-1.5 text-sm leading-none font-bold text-[#D1DF64] uppercase">
        Opportunità
      </span>

      <h2 class="mt-[17px] font-bold text-white leading-[1.25] tracking-[-1px]">
        Le occasioni di lavoro nascono dentro alla community, non fuori.
      </h2>

      <div class="mx-auto mt-8 flex max-w-5xl flex-col gap-8 rounded-[24px] bg-white/10 px-[54px] py-[46px] md:flex-row">
        <div class="aspect-[405/276] w-full shrink-0 rounded-[14px] bg-[#825CBB] bg-[url('/images/people-gathering.webp')] bg-cover bg-center md:w-[405px]"></div>

        <div class="flex flex-1 flex-col gap-3">
          {
            OPPORTUNITY_PILLS.map((pill) => (
              <div class="flex items-center gap-3.5 rounded-2xl border border-[#0B0B0E17] bg-white p-4">
                <img src={pill.icon} alt="" width="40" height="40" class="size-10 shrink-0" />
                <p class="text-sm leading-normal font-semibold text-black">{pill.text}</p>
              </div>
            ))
          }
        </div>
      </div>

      <p class="mx-auto mt-8 max-w-3xl text-base leading-normal text-white/80">
        Quando entri nella parte paid, sblocchi una bacheca dedicata dove i membri pubblicano e trovano:
        collaborazioni tra prodottizzati (subcontracting), clienti che cercano un servizio ad abbonamento,
        posizioni aperte all'interno delle agenzie/community member.
      </p>

      <div class="mt-10 text-center">
        <Button href="#">Entra nella community</Button>
      </div>
    </div>

    <div class="mt-14 overflow-hidden">
      <div class="opportunity-track flex w-max gap-5 px-container">
        {
          [...OPPORTUNITY_TESTIMONIALS, ...OPPORTUNITY_TESTIMONIALS].map((t, i) => (
            <div
              aria-hidden={i >= OPPORTUNITY_TESTIMONIALS.length}
              class="glass-border w-[420px] shrink-0 rounded-[24px] bg-white/10 pt-9 pr-[30px] pb-9 pl-[30px]"
            >
              <p class="text-base leading-normal font-medium text-white">{t.quote}</p>
              <div class="mt-5 flex items-center gap-3">
                <div
                  class="flex size-11 shrink-0 items-center justify-center rounded-full text-xl leading-normal font-medium text-white"
                  style={{ backgroundColor: t.color }}
                >
                  {t.initials}
                </div>
                <p class="text-base leading-normal text-white">{t.name}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .opportunity-track {
    animation: opportunity-sway 4.5s ease-in-out infinite alternate;
  }

  /* Pendulum: slide until the last card meets the right edge, then swing back. */
  @keyframes opportunity-sway {
    to {
      transform: translateX(min(0px, calc(100vw - 100%)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opportunity-track {
      animation: none;
    }
  }
</style>
