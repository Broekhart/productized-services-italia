---
import { ANNUAL_FEATURES, MONTHLY_FEATURES } from '../../lib/const';
import Button from '../ui/button.astro';
import CheckCircleOutline from '../ui/icons/checkcircleoutline.astro';
import BurstBadge from '../ui/icons/burstbadge.astro';
import Badge from '../ui/badge.astro';
import Arrow from '../ui/icons/arrow.astro';
---

<section>
  <div class='text-white bg-coral pricing-cover'>
    <div class='flex flex-col items-start gap-4 p-container lg:h-110'>
      <Badge variant='light-coral'>Scegli il tuo piano</Badge>

      <h2 class='max-w-3xl'>Tutto ciò che ti serve per costruire il tuo Productized Service.</h2>
    </div>
  </div>

  <div class='relative p-container -mt-45 grid lg:grid-cols-2 items-start gap-8'>
    <div class='flex flex-col gap-7 rounded-2xl border border-black/5 bg-white p-8 shadow-sm'>
      <span class='font-bold tracking-wider text-coral uppercase'> Piano Mensile </span>

      <div class='flex items-baseline gap-2'>
        <h3 class='text-h1 font-bold'>€49</h3>
        <span class='font-semibold text-black/60'>/mese</span>
      </div>

      <p class='text-black/60'>
        Tutto ciò che ti serve per trasformare il tuo servizio in un'offerta productized. Accesso alla
        community, corso completo e tutte le opportunità riservate ai membri.
      </p>

      <hr class='border border-gray-200' />

      <ul class='flex flex-col gap-4'>
        {
          MONTHLY_FEATURES.map((feature) => (
            <li class='flex items-center gap-4 font-medium'>
              <CheckCircleOutline class='size-6 shrink-0' />
              {feature}
            </li>
          ))
        }
      </ul>

      <Button href='https://www.skool.com/productized-services-italia-4079/about' target='_blank' rel='noopener noreferrer' variant='outline' class='w-full justify-center'> Entra nella community Skool <Arrow/> </Button>
    </div>

    <div class='relative flex flex-col gap-7 rounded-2xl border-[3px] border-black bg-white p-8 shadow-sm'>
      <div
        class='font-bold grid place-items-center absolute -top-12 -right-6 rotate-14 h-30.75 w-35 text-center'>
        <BurstBadge class='absolute inset-0 -z-10 size-full' />
        <div>
        <p>Risparmia</p>
        <span class='text-4xl'>€98</span>
        </div>
      </div>

      <span class='font-bold tracking-wider text-coral uppercase'> Piano Annuale </span>

      <div class='flex flex-wrap font-bold items-baseline gap-3'>
        <span class='text-h2 text-black/40 line-through'>€588</span>
        <p class='text-h1 text-black'>€490  <span class='text-base font-semibold text-black/60'>/anno</span></p>
      </div>

      <p class='text-black/60'>
        Un anno intero per costruire e far crescere il tuo Productized Service. Accesso completo alla
        community, al corso e alle opportunità di lavoro, con un unico pagamento annuale.
      </p>

      <hr class='border border-gray-200' />

      <ul class='flex flex-col gap-4'>
        {
          ANNUAL_FEATURES.map((feature) => (
            <li class='flex items-center gap-4 font-medium'>
              <CheckCircleOutline class='size-6 shrink-0' />
              {feature}
            </li>
          ))
        }
      </ul>

      <Button variant="secondary" href='https://www.skool.com/productized-services-italia-4079/about' target='_blank' rel='noopener noreferrer' class='mt-8 w-full justify-center'>
        Entra nella community Skool
        <Arrow />
      </Button>
    </div>
  </div>
</section>
