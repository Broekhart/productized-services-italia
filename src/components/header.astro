---
import Button from './ui/button.astro';
import Logo from './ui/logo.astro';
import { NAV_LINKS } from '../lib/const';
import Arrow from './ui/icons/arrow.astro';
---

<header class='absolute top-0 left-0 z-10 py-6 w-full text-white'>
  <div class='px-container flex items-center justify-between gap-4'>
    <Logo class='md:justify-self-start' />

    <nav aria-label='Navigazione principale' class='hidden md:flex items-center gap-6'>
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class='font-medium'>
            {link.label}
          </a>
        ))
      }
    </nav>

    <Button
      href='https://www.skool.com/productized-services-italia-4079/about'
      target='_blank'
      rel='noopener noreferrer'>
      Entra nella community <Arrow />
    </Button>
  </div>
</header>
