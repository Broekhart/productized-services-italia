	description="Impara a creare, vendere e gestire servizi prodottizzati. Entra nella community italiana per freelance, segui il corso e trova nuove opportunità."
>
	<Fragment slot="head">
		<script
			type="module"
			src="https://cdn.jsdelivr.net/npm/@videojs/cdn@10.1.0/video-compat.js"
		></script>
	</Fragment>
	<Hero />
	<Stats />
	<Problem />
	<WhatsInside />
	<Story />
	<Community />
	<Tour />
	<Opportunity />
	<Method />
	<Comparison />
	<Course />
	<Pricing />
	<Testimonials />
	<Faq />
</Layout>
