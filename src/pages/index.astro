---
import Community from "../components/home/community.astro";
import Comparison from "../components/home/comparison.astro";
import Course from "../components/home/course.astro";
import Faq from "../components/home/faq.astro";
import Hero from "../components/home/hero.astro";
import Method from "../components/home/method.astro";
import Opportunity from "../components/home/opportunity.astro";
import Pricing from "../components/home/pricing.astro";
import Problem from "../components/home/problem.astro";
import Stats from "../components/home/stats.astro";
